  "bucket_id" text [not null]
  "key" text [not null]
  "etag" text [not null]
  "owner_id" text
  "version" text [not null]
  "created_at" timestamptz [not null, default: `now()`]
}

Table "storage"."buckets_analytics" {
  "name" text [unique, not null]
