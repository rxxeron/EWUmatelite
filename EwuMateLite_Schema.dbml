Ref "course_metadata_equivalent_code_fkey":"course_metadata"."code" < "course_metadata"."equivalent_code"

Ref "enrollments_semester_code_fkey":"semesters"."code" < "enrollments"."semester_code" [delete: cascade]

Ref "enrollments_user_id_fkey":"profiles"."id" < "enrollments"."user_id" [delete: cascade]

Ref "fcm_tokens_user_id_fkey":"profiles"."id" < "fcm_tokens"."user_id" [delete: cascade]

Ref "notifications_user_id_fkey":"profiles"."id" < "notifications"."user_id" [delete: cascade]

Ref "profiles_admitted_semester_fkey":"semesters"."code" < "profiles"."admitted_semester"

Ref "profiles_department_code_fkey":"programs"."program_code" < "profiles"."program_code"

Ref "schedule_exceptions_user_id_fkey":"profiles"."id" < "schedule_exceptions"."user_id" [delete: cascade]

Ref "scholarship_policies_department_code_fkey":"programs"."program_code" < "scholarship_policies"."department_code" [delete: cascade]

Ref "scholarship_policies_effective_from_semester_fkey":"semesters"."code" < "scholarship_policies"."effective_from_semester"

Ref "scholarship_policies_effective_until_semester_fkey":"semesters"."code" < "scholarship_policies"."effective_until_semester"

Ref "semester_summaries_user_id_fkey":"profiles"."id" < "semester_summaries"."user_id" [delete: cascade]

Ref "user_semester_states_semester_code_fkey":"semesters"."code" < "user_semester_states"."semester_code" [delete: cascade]

Ref "user_semester_states_user_id_fkey":"profiles"."id" < "user_semester_states"."user_id" [delete: cascade]

Enum "realtime"."action" {
  "INSERT"
  "UPDATE"
  "DELETE"
  "TRUNCATE"
  "ERROR"
}

Enum "realtime"."equality_op" {
  "eq"
  "neq"
  "lt"
  "lte"
  "gt"
  "gte"
  "in"
}

Table "realtime"."schema_migrations" {
  "version" int8 [pk, not null]
  "inserted_at" timestamp
}

Table "realtime"."subscription" {
  "id" int8 [pk, not null, increment]
  "subscription_id" uuid [not null]
  "entity" regclass [not null]
  "filters" "user_defined_filter[]" [not null, default: 'ARRAY[realtime.user_defined_filter[]']
  "claims" jsonb [not null]
  "claims_role" regrole [not null]
  "created_at" timestamp [not null, default: `timezone('utc'::text, now())`]
  "action_filter" text [check: `action_filter = ANY (ARRAY['*'::text, 'INSERT'::text, 'UPDATE'::text, 'DELETE'::text])`, default: '*']

  Indexes {
    (subscription_id, entity, filters, action_filter) [type: btree, unique, name: "subscription_subscription_id_entity_filters_action_filter_key"]
    entity [type: btree, name: "ix_realtime_subscription_entity"]
  }
}

Enum "storage"."buckettype" {
  "STANDARD"
  "ANALYTICS"
  "VECTOR"
}

Table "storage"."migrations" {
  "id" int4 [pk, not null]
  "name" varchar(100) [unique, not null]
  "hash" varchar(40) [not null]
  "executed_at" timestamp [default: `CURRENT_TIMESTAMP`]
}

Table "storage"."buckets" {
  "id" text [pk, not null]
  "name" text [unique, not null]
  "owner" uuid [note: 'Field is deprecated, use owner_id instead']
  "created_at" timestamptz [default: `now()`]
  "updated_at" timestamptz [default: `now()`]
  "public" bool [default: false]
  "avif_autodetection" bool [default: false]
  "file_size_limit" int8
  "allowed_mime_types" "text[]"
  "owner_id" text
  "type" storage.buckettype [not null, default: 'STANDARD']
}

Table "storage"."objects" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "bucket_id" text
  "name" text
  "owner" uuid [note: 'Field is deprecated, use owner_id instead']
  "created_at" timestamptz [default: `now()`]
  "updated_at" timestamptz [default: `now()`]
  "last_accessed_at" timestamptz [default: `now()`]
  "metadata" jsonb
  "path_tokens" "text[]"
  "version" text
  "owner_id" text
  "user_metadata" jsonb

  Indexes {
    (bucket_id, name) [type: btree, unique, name: "bucketid_objname"]
    (bucket_id, name) [type: btree, name: "idx_objects_bucket_id_name"]
    (bucket_id, `lower(name)`) [type: btree, name: "idx_objects_bucket_id_name_lower"]
    name [type: btree, name: "name_prefix_search"]
  }
}

Table "storage"."s3_multipart_uploads" {
  "id" text [pk, not null]
  "in_progress_size" int8 [not null, default: 0]
  "upload_signature" text [not null]
  "bucket_id" text [not null]
  "key" text [not null]
  "version" text [not null]
  "owner_id" text
  "created_at" timestamptz [not null, default: `now()`]
  "user_metadata" jsonb
  "metadata" jsonb

  Indexes {
    (bucket_id, key, created_at) [type: btree, name: "idx_multipart_uploads_list"]
  }
}

Table "storage"."s3_multipart_uploads_parts" {
  "id" uuid [pk, not null, default: `gen_random_uuid()`]
  "upload_id" text [not null]
