<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="750.0" prefWidth="700.0" spacing="20.0" styleClass="content-area-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ewumatelite.features.semester_progress.presentation.SemesterProgressController">
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>

   <!-- Header -->
   <VBox alignment="CENTER" spacing="5.0">
      <Label styleClass="title-label" text="Academic Progress" />
      <Label fx:id="semesterLabel" style="-fx-text-fill: #0EA5E9; -fx-font-size: 14px; -fx-font-weight: bold;" text="Spring 2026" />
   </VBox>

   <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
      <content>
         <FlowPane fx:id="courseContainer" hgap="20.0" style="-fx-background-color: transparent;" vgap="20.0">
            <Label fx:id="loadingLabel" styleClass="label" text="Loading course data..." />
         </FlowPane>
      </content>
   </ScrollPane>
</VBox>