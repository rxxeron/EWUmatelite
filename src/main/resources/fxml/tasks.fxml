<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.Region?>

<VBox prefHeight="750.0" prefWidth="700.0" spacing="20.0" styleClass="content-area-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ewumatelite.features.tasks.presentation.TasksController">
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>

   <!-- Header -->
   <HBox alignment="CENTER_LEFT" spacing="15.0">
      <Label styleClass="title-label" text="My Tasks" />
      <Pane HBox.hgrow="ALWAYS" />
      <Button fx:id="addTaskBtn" onAction="#onAddTaskClicked" styleClass="button" text="+ Add Task" />
   </HBox>

   <TabPane fx:id="taskTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="tab-pane" VBox.vgrow="ALWAYS">
      <!-- Upcoming Tab -->
      <tabs>
         <Tab text="Upcoming">
            <content>
               <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                  <content>
                     <VBox fx:id="upcomingTasksContainer" spacing="12.0" style="-fx-background-color: transparent;">
                        <padding>
                           <Insets top="15.0" />
                        </padding>
                     </VBox>
                  </content>
               </ScrollPane>
            </content>
         </Tab>
         
         <!-- Overdue Tab -->
         <Tab text="Overdue">
            <content>
               <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                  <content>
                     <VBox fx:id="overdueTasksContainer" spacing="12.0" style="-fx-background-color: transparent;">
                        <padding>
                           <Insets top="15.0" />
                        </padding>
                     </VBox>
                  </content>
               </ScrollPane>
            </content>
         </Tab>
         
         <!-- Completed Tab -->
         <Tab text="Completed">
            <content>
               <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                  <content>
                     <VBox fx:id="completedTasksContainer" spacing="12.0" style="-fx-background-color: transparent;">
                        <padding>
                           <Insets top="15.0" />
                        </padding>
                     </VBox>
                  </content>
               </ScrollPane>
            </content>
         </Tab>
      </tabs>
   </TabPane>
</VBox>