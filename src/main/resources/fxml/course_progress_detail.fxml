<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>

<VBox prefHeight="750.0" prefWidth="700.0" spacing="20.0" styleClass="content-area-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ewumatelite.features.semester_progress.presentation.CourseProgressDetailController">
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>

   <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 0 0 10 0;">
      <Label onMouseClicked="#onBackClicked" styleClass="text-button" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="&#8592;" />
      <Pane HBox.hgrow="ALWAYS" />
      <Label fx:id="headerTitle" styleClass="title-label" style="-fx-font-size: 20px;" text="COURSE" />
      <Pane HBox.hgrow="ALWAYS" />
      <Button fx:id="saveBtn" onAction="#onSaveClicked" styleClass="button" text="&#10003;" />
   </HBox>

   <HBox alignment="CENTER" spacing="40.0" style="-fx-padding: 0 0 20 0;">
      <Button fx:id="setupBtn" onAction="#showSetup" styleClass="tab" text="Setup" />
      <Button fx:id="marksBtn" onAction="#showMarks" styleClass="tab" style="-fx-background-color: rgba(14, 165, 233, 0.2); -fx-text-fill: white;" text="Marks" />
   </HBox>
   
   <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <content>
           <VBox spacing="30.0" style="-fx-background-color: transparent;">
               <HBox alignment="CENTER" spacing="80.0">
                  <VBox alignment="CENTER">
                     <Label fx:id="totalExpectedLabel" styleClass="title-label" style="-fx-text-fill: #22D3EE; -fx-font-size: 18px;" text="Obtained: 0.0 / 0.0" />
                     <Label fx:id="cgpaLabel" styleClass="label" text="Expected: F" />
                  </VBox>
               </HBox>

               <StackPane>
                  <VBox fx:id="setupContainer" spacing="15.0" visible="false" managed="false" />
                  <VBox fx:id="marksContainer" spacing="15.0" />
               </StackPane>
               
               <Label fx:id="remarksLabel" alignment="CENTER" maxWidth="Infinity" styleClass="label" style="-fx-font-size: 13px;" text="Save changes manually by clicking the checkmark icon." />
           </VBox>
        </content>
   </ScrollPane>
</VBox>
